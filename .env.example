# Скопируйте в .env и заполните. Файл .env не коммитится.

# Токен от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# Время ежедневной автопроверки по умолчанию и часовой пояс
MONITOR_TIME=18:00
TIMEZONE=Asia/Almaty

# Кто может пользоваться ботом: Telegram user_id через запятую. Пусто — доступ для всех.
# Свой ID можно узнать, написав боту: при закрытом доступе он его покажет.
ALLOWED_TELEGRAM_USER_IDS=

# Где хранить базу (SQLite). В Docker — в томе ./data
DB_PATH=data/bot.db

# Сколько одновременных запросов к порталу
PORTAL_CONCURRENCY=3
